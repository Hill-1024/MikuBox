<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Base theme ported from MikuBoxForSingbox: Material3 Expressive with the
        MikuRay colour-role shims (colorBg / colorCard / accentOr* / …) that the
        ported layouts reference. The concrete palette is applied by the child
        Theme.MikuBoxCla below.
    -->
    <style name="AppThemeBase" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <!-- The chrome (app bar, status panel) is colourPrimary, so the system
             bar icons ride on-primary: white in the light theme, ink at night. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.LargeComponent</item>
        <item name="android:colorBackground">?colorBg</item>
        <item name="android:windowBackground">?colorBg</item>
        <item name="colorBg">?colorSurfaceVariant</item>
        <item name="colorCard">?colorSurfaceContainerLow</item>
        <item name="android:scrollbarSize">0.0dip</item>
        <item name="android:listDivider">@null</item>
        <item name="android:colorEdgeEffect">@null</item>
        <item name="elevation">0.0dip</item>

        <item name="colorMaterial100">?attr/colorPrimaryContainer</item>
        <item name="colorMaterial300">?attr/colorSecondaryContainer</item>
        <item name="accentOrTextSecondary">?attr/colorSecondary</item>
        <item name="accentOrTextPrimary">?attr/colorSecondary</item>
        <item name="primaryOrTextSecondary">?attr/colorPrimary</item>
        <item name="primaryOrTextPrimary">?attr/colorPrimary</item>
        <item name="fabColorBackground">?attr/colorPrimary</item>
        <item name="selectedColorPrimary">?attr/colorPrimary</item>
        <item name="whiteOrTextPrimary">?attr/colorOnPrimary</item>
        <item name="itemShapeFillColor">?attr/colorSecondaryContainer</item>
        <item name="tabTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="tabSelectedTextColor">?attr/colorPrimary</item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabRippleColor">?attr/colorPrimary</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.App.MediumComponent</item>
        <item name="collapsingToolbarLayoutLargeStyle">@style/Miku.CollapsingToolbar.Large</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Miku.MaterialAlertDialog</item>
        <item name="android:windowAnimationStyle">@style/Animation.Miku.Activity</item>
    </style>

    <!-- Calm shared-axis style screen transitions, applied app-wide. -->
    <style name="Animation.Miku.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/uwu_activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/uwu_activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/uwu_activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/uwu_activity_close_exit</item>
    </style>

    <!-- MikuRay-style dialogs: rounded surface-container background with a
         filled primary confirm button. Applied app-wide via the theme. -->
    <style name="ThemeOverlay.Miku.MaterialAlertDialog" parent="@style/ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurfaceContainerHigh">?attr/colorSurfaceContainer</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Miku.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Miku.Dialog.Button.Filled</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Miku.Dialog.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Miku.Dialog.Button.Text</item>
    </style>

    <style name="ShapeAppearance.Miku.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!--
        AMOLED overlay placeholder: the real one lives in values-night so it can
        only ever take effect in the dark theme, but the id has to exist in the
        default configuration for code to reference it.
    -->
    <style name="ThemeOverlay.Miku.TrueBlack" parent="" />

    <style name="Widget.Miku.Dialog.Button.Filled" parent="@style/Widget.Material3.Button.TonalButton">
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
    </style>

    <style name="Widget.Miku.Dialog.Button.Text" parent="@style/Widget.Material3.Button.TextButton.Dialog" />

    <!-- MikuRay display font on the large collapsing page titles. -->
    <style name="Miku.CollapsingToolbar.Large" parent="@style/Widget.Material3.CollapsingToolbar.Large">
        <item name="expandedTitleTextAppearance">@style/TextAppearance.Miku.CollapsingExpanded</item>
        <item name="collapsedTitleTextAppearance">@style/TextAppearance.Miku.CollapsingCollapsed</item>
    </style>

    <style name="TextAppearance.Miku.CollapsingExpanded" parent="@style/TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/uwu_font_title</item>
        <item name="android:fontFamily">@font/uwu_font_title</item>
    </style>

    <style name="TextAppearance.Miku.CollapsingCollapsed" parent="@style/TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/uwu_font_title</item>
        <item name="android:fontFamily">@font/uwu_font_title</item>
    </style>

    <!--
        Default palette: the release Teal family. Every colour role comes from
        the generated Material 3 tonal ramp, so containers, outlines and
        surfaces stay in the same harmony; the family themes in
        themes_families.xml only swap these bindings.
    -->
    <style name="Theme.MikuBoxCla" parent="AppThemeBase">
        <item name="colorPrimary">@color/t_teal_primary</item>
        <item name="colorOnPrimary">@color/t_teal_onPrimary</item>
        <item name="colorPrimaryContainer">@color/t_teal_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/t_teal_onPrimaryContainer</item>
        <item name="colorSecondary">@color/t_teal_secondary</item>
        <item name="colorOnSecondary">@color/t_teal_onSecondary</item>
        <item name="colorSecondaryContainer">@color/t_teal_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/t_teal_onSecondaryContainer</item>
        <item name="colorTertiary">@color/t_teal_tertiary</item>
        <item name="colorOnTertiary">@color/t_teal_onTertiary</item>
        <item name="colorTertiaryContainer">@color/t_teal_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/t_teal_onTertiaryContainer</item>
        <item name="colorError">@color/t_teal_error</item>
        <item name="colorOnError">@color/t_teal_onError</item>
        <item name="colorErrorContainer">@color/t_teal_errorContainer</item>
        <item name="colorOnErrorContainer">@color/t_teal_onErrorContainer</item>
        <item name="android:colorBackground">@color/t_teal_background</item>
        <item name="colorOnBackground">@color/t_teal_onBackground</item>
        <item name="colorSurface">@color/t_teal_surface</item>
        <item name="colorOnSurface">@color/t_teal_onSurface</item>
        <item name="colorSurfaceVariant">@color/t_teal_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/t_teal_onSurfaceVariant</item>
        <item name="colorOutline">@color/t_teal_outline</item>
        <item name="colorOutlineVariant">@color/t_teal_outlineVariant</item>
        <item name="colorSurfaceDim">@color/t_teal_surfaceDim</item>
        <item name="colorSurfaceBright">@color/t_teal_surfaceBright</item>
        <item name="colorSurfaceContainerLowest">@color/t_teal_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/t_teal_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/t_teal_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/t_teal_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/t_teal_surfaceContainerHighest</item>
        <item name="colorSurfaceInverse">@color/t_teal_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/t_teal_inverseOnSurface</item>
        <item name="colorPrimaryFixed">@color/t_teal_primaryFixed</item>
        <item name="colorOnPrimaryFixed">@color/t_teal_onPrimaryFixed</item>
        <item name="colorPrimaryFixedDim">@color/t_teal_primaryFixedDim</item>
        <item name="colorOnPrimaryFixedVariant">@color/t_teal_onPrimaryFixedVariant</item>
        <item name="colorSecondaryFixed">@color/t_teal_secondaryFixed</item>
        <item name="colorOnSecondaryFixed">@color/t_teal_onSecondaryFixed</item>
        <item name="colorSecondaryFixedDim">@color/t_teal_secondaryFixedDim</item>
        <item name="colorOnSecondaryFixedVariant">@color/t_teal_onSecondaryFixedVariant</item>
        <item name="colorTertiaryFixed">@color/t_teal_tertiaryFixed</item>
        <item name="colorOnTertiaryFixed">@color/t_teal_onTertiaryFixed</item>
        <item name="colorTertiaryFixedDim">@color/t_teal_tertiaryFixedDim</item>
        <item name="colorOnTertiaryFixedVariant">@color/t_teal_onTertiaryFixedVariant</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <!--
        Chrome surfaces. Every screen paints its app bar with colourPrimary and
        its content with colourBg, so these two styles are the only place the
        light / night split has to be expressed per-layout.
    -->
    <style name="UwuAppBar" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/colorPrimary</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="UwuCollapsingToolbar" parent="@style/Widget.Material3.CollapsingToolbar.Large">
        <item name="expandedTitleTextAppearance">@style/TextAppearance.Miku.CollapsingExpanded</item>
        <item name="collapsedTitleTextAppearance">@style/TextAppearance.Miku.CollapsingCollapsed</item>
    </style>

    <style name="ShapeAppearance.App.SmallComponent" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Invisible host for the VpnService consent handshake. -->
    <style name="Theme.MikuBoxCla.Translucent" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

</resources>
