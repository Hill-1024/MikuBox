<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        The night palette now comes from the Material 3 tonal ramps in
        values-night/colors_themes.xml, so the theme itself only has to state the
        system-bar behaviour and the AMOLED overlay.
    -->

    <!--
        Pure-black overlay for OLED panels, applied on top of whichever theme is
        active (preset family or dynamic). Only resolvable in the night
        configuration, which is also the only time it is applied.
    -->
    <style name="ThemeOverlay.Miku.TrueBlack" parent="@style/ThemeOverlay.Material3Expressive">
        <item name="android:windowBackground">#ff000000</item>
        <item name="android:colorBackground">#ff000000</item>
        <item name="colorSurface">#ff000000</item>
        <item name="colorOnBackground">#fff5f5f5</item>
        <item name="colorOnSurface">#fff5f5f5</item>
        <item name="colorSurfaceContainerLowest">#ff000000</item>
        <item name="colorSurfaceContainerLow">#ff0d0d0d</item>
        <item name="colorSurfaceContainer">#ff121212</item>
        <item name="colorSurfaceContainerHigh">#ff1a1a1a</item>
        <item name="colorSurfaceContainerHighest">#ff242424</item>
        <item name="colorSurfaceVariant">#ff121212</item>
        <item name="colorOnSurfaceVariant">#ffc9c6ca</item>
        <item name="colorOutline">#ff938f99</item>
        <item name="colorOutlineVariant">#ff49454f</item>
        <item name="colorSurfaceInverse">#ffe6e1e5</item>
        <item name="colorOnSurfaceInverse">#ff313033</item>
        <item name="colorBg">#ff000000</item>
        <item name="colorCard">#ff131313</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">false</item>
        <item name="android:enforceNavigationBarContrast" tools:ignore="NewApi">false</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Miku.TrueBlack.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Miku.TrueBlack.Dialog</item>
    </style>

    <style name="ThemeOverlay.Miku.TrueBlack.Dialog" parent="@style/ThemeOverlay.Miku.MaterialAlertDialog">
        <item name="android:colorBackground">#ff131313</item>
        <item name="colorSurfaceContainerHigh">#ff1a1a1a</item>
    </style>

</resources>
