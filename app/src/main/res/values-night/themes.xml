<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Night override of the base theme. The colour *resources* already flip by
        configuration; the one binding that cannot is colorBg, because the night
        page must sit on colourSurface (darker than the cards) — keeping
        colourSurfaceVariant here left the page lighter than the cards and
        inverted the contrast. System-bar icons flip to dark because the night
        chrome (colourPrimary) is bright.
    -->
    <style name="AppThemeBase" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.LargeComponent</item>
        <item name="android:colorBackground">?colorBg</item>
        <item name="android:windowBackground">?colorBg</item>
        <item name="colorBg">?colorSurface</item>
        <item name="colorCard">?colorSurfaceContainerLow</item>
        <item name="android:scrollbarSize">0.0dip</item>
        <item name="android:listDivider">@null</item>
        <item name="android:colorEdgeEffect">@null</item>
        <item name="elevation">0.0dip</item>
        <item name="android:windowLightStatusBar">@bool/uwu_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/uwu_light_system_bars</item>
        <item name="colorMaterial100">?attr/colorPrimaryContainer</item>
        <item name="colorMaterial300">?attr/colorSecondaryContainer</item>
        <item name="accentOrTextSecondary">?attr/colorSecondary</item>
        <item name="accentOrTextPrimary">?attr/colorSecondary</item>
        <item name="primaryOrTextSecondary">?attr/colorPrimary</item>
        <item name="primaryOrTextPrimary">?attr/colorPrimary</item>
        <item name="fabColorBackground">?attr/colorPrimary</item>
        <item name="selectedColorPrimary">?attr/colorPrimary</item>
        <item name="whiteOrTextPrimary">?attr/colorOnPrimary</item>
        <item name="colorIcon">@color/white</item>
        <item name="itemShapeFillColor">?attr/colorSecondaryContainer</item>
        <item name="tabTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="tabSelectedTextColor">?attr/colorPrimary</item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabRippleColor">?attr/colorPrimary</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.App.MediumComponent</item>
        <item name="collapsingToolbarLayoutLargeStyle">@style/Miku.CollapsingToolbar.Large</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Miku.MaterialAlertDialog</item>
        <item name="toolbarStyle">@style/Widget.Miku.Toolbar</item>
    </style>

    <!--
        Pure-black overlay for OLED panels, applied on top of whichever theme is
        active (preset family or dynamic). Only meaningful in the dark theme.
    -->
    <style name="ThemeOverlay.Miku.TrueBlack" parent="@style/ThemeOverlay.Material3Expressive">
        <item name="android:windowBackground">#ff000000</item>
        <item name="android:colorBackground">#ff000000</item>
        <item name="colorSurface">#ff000000</item>
        <item name="colorOnBackground">#fff5f5f5</item>
        <item name="colorOnSurface">#fff5f5f5</item>
        <item name="colorSurfaceContainerLowest">#ff000000</item>
        <item name="colorSurfaceContainerLow">#ff0d0d0d</item>
        <item name="colorSurfaceContainer">#ff121212</item>
        <item name="colorSurfaceContainerHigh">#ff1a1a1a</item>
        <item name="colorSurfaceContainerHighest">#ff242424</item>
        <item name="colorSurfaceVariant">#ff121212</item>
        <item name="colorOnSurfaceVariant">#ffc9c6ca</item>
        <item name="colorOutline">#ff938f99</item>
        <item name="colorOutlineVariant">#ff49454f</item>
        <item name="colorSurfaceInverse">#ffe6e1e5</item>
        <item name="colorOnSurfaceInverse">#ff313033</item>
        <item name="colorBg">#ff000000</item>
        <item name="colorCard">#ff131313</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Miku.TrueBlack.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Miku.TrueBlack.Dialog</item>
    </style>

    <style name="ThemeOverlay.Miku.TrueBlack.Dialog" parent="@style/ThemeOverlay.Miku.MaterialAlertDialog">
        <item name="android:colorBackground">#ff131313</item>
        <item name="colorSurfaceContainerHigh">#ff1a1a1a</item>
    </style>

</resources>
