<?xml version="1.0" encoding="utf-8"?>
<!--
    One profile on the home list: leading shape tile, name with the row actions
    on the same line, kind pills, then the update line and the traffic the
    profile has carried. Selected rows swap the surface for the secondary
    container through the indicator layer, the same trick the release design
    uses for its selected server.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="4dp"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorCard"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:rippleColor="@color/uwu_state_layer"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/layout_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/info_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="8dp"
                android:paddingBottom="10dp">

                <!-- Shape tile: primary surface with the profile kind glyph. -->
                <FrameLayout
                    android:id="@+id/iv_profile_tile"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_gravity="top"
                    android:background="@drawable/uwu_bg_circle_primary">

                    <ImageView
                        android:id="@+id/iv_profile_glyph"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_subscriptions_24dp"
                        app:tint="?attr/colorOnPrimary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="Miku subscription" />

                        <ImageView
                            android:id="@+id/iv_pin"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp"
                            android:contentDescription="@string/proxies_pinned"
                            android:src="@drawable/ic_map_marker_outline"
                            app:tint="?attr/colorPrimary"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <View
                            android:id="@+id/v_status_dot"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/uwu_blink_color"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:id="@+id/layout_share"
                            style="@style/UwuRowAction"
                            android:contentDescription="@string/action_share"
                            android:src="@drawable/ic_share_24dp"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <ImageView
                            android:id="@+id/layout_update"
                            style="@style/UwuRowAction"
                            android:contentDescription="@string/action_update"
                            android:src="@drawable/ic_cloud_download_24dp"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <ImageView
                            android:id="@+id/layout_remove"
                            style="@style/UwuRowAction"
                            android:contentDescription="@string/action_delete"
                            android:src="@drawable/ic_delete_empty"
                            app:tint="?attr/colorError" />

                        <ImageView
                            android:id="@+id/layout_more"
                            style="@style/UwuRowAction"
                            android:contentDescription="@string/action_more"
                            android:src="@drawable/ic_baseline_more_vert_24"
                            app:tint="?attr/colorOnSurfaceVariant"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_pill_kind"
                            style="@style/UwuPillSecondary"
                            tools:text="Subscription" />

                        <TextView
                            android:id="@+id/tv_pill_sub"
                            style="@style/UwuPillTertiary"
                            android:layout_marginStart="6dp"
                            android:visibility="gone"
                            tools:text="example.com"
                            tools:visibility="visible" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tv_test_result"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/ping_green"
                            android:textSize="13sp"
                            tools:text="128 ms" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_statistics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        tools:text="Updated 2 hours ago" />

                    <TextView
                        android:id="@+id/tv_traffic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:drawablePadding="5dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="↑ 1.2 MiB  ↓ 12.4 MiB"
                        tools:visibility="visible" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/update_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:visibility="gone"
                        app:indicatorColor="?attr/colorPrimary"
                        app:trackColor="?attr/colorSurfaceContainerHighest"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
