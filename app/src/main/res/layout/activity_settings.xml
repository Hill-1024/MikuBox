<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            style="?attr/collapsingToolbarLayoutLargeStyle"
            android:layout_height="?attr/collapsingToolbarLayoutLargeSize"
            android:background="?attr/colorPrimary"
            app:collapsedTitleTextColor="?attr/colorOnPrimary"
            app:contentScrim="?attr/colorPrimary"
            app:expandedTitleMarginEnd="24dp"
            app:expandedTitleMarginStart="24dp"
            app:expandedTitleTextColor="?attr/colorOnPrimary"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:statusBarScrim="?attr/colorPrimary"
            app:title="@string/settings"
            app:titleCollapseMode="scale">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/uwu_circle_back"
                app:titleTextColor="?attr/colorOnPrimary" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/uwu_banner_settings_port" />

            <!-- maintainer notice -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/uwu_maintainer_title"
                            android:textColor="?attr/colorOnPrimary"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/uwu_maintainer_summary"
                            android:textColor="?attr/colorOnPrimary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_account_cog_outline"
                        android:tint="?attr/colorOnPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Appearance ===== -->
            <LinearLayout style="@style/UwuSectionHeader">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/uwu_icon_miku" />
                <TextView
                    style="@style/UwuSectionHeaderLabel"
                    android:text="@string/settings_section_appearance" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/row_theme"
                        style="@style/SettingsRow">

                        <FrameLayout style="@style/UwuRowBadge">
                            <ImageView style="@style/UwuRowBadgePlate" />
                            <ImageView
                                style="@style/UwuRowBadgeGlyph"
                                android:src="@drawable/ic_palette_24" />
                        </FrameLayout>

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_theme" />

                            <TextView
                                android:id="@+id/tv_theme_value"
                                style="@style/SettingsRowSummary"
                                tools:ignore="MissingClass" />
                        </LinearLayout>

                        <ImageView style="@style/UwuRowChevron" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/row_language"
                        style="@style/SettingsRow">

                        <FrameLayout style="@style/UwuRowBadge">
                            <ImageView style="@style/UwuRowBadgePlate" />
                            <ImageView
                                style="@style/UwuRowBadgeGlyph"
                                android:src="@drawable/ic_translate" />
                        </FrameLayout>

                        <LinearLayout style="@style/SettingsRowText">
                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_language" />
                            <TextView
                                android:id="@+id/tv_language_value"
                                style="@style/SettingsRowSummary" />
                        </LinearLayout>

                        <ImageView style="@style/UwuRowChevron" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/row_particles"
                        style="@style/SettingsRow">

                        <FrameLayout style="@style/UwuRowBadge">
                            <ImageView style="@style/UwuRowBadgePlate" />
                            <ImageView
                                style="@style/UwuRowBadgeGlyph"
                                android:src="@drawable/ic_baseline_blur_on_24" />
                        </FrameLayout>

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_particles" />

                            <TextView
                                style="@style/SettingsRowSummary"
                                android:text="@string/settings_particles_summary" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_particles"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:clickable="false"
                            android:focusable="false" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Connection ===== -->
            <LinearLayout style="@style/UwuSectionHeader">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/uwu_icon_miku" />
                <TextView
                    style="@style/UwuSectionHeaderLabel"
                    android:text="@string/settings_section_connection" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/row_boot"
                        style="@style/SettingsRow">

                        <FrameLayout style="@style/UwuRowBadge">
                            <ImageView style="@style/UwuRowBadgePlate" />
                            <ImageView
                                style="@style/UwuRowBadgeGlyph"
                                android:src="@drawable/ic_clock" />
                        </FrameLayout>

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_boot" />

                            <TextView
                                style="@style/SettingsRowSummary"
                                android:text="@string/settings_boot_summary" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_boot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:clickable="false"
                            android:focusable="false" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/row_mtu"
                        style="@style/SettingsRow">

                        <FrameLayout style="@style/UwuRowBadge">
                            <ImageView style="@style/UwuRowBadgePlate" />
                            <ImageView
                                style="@style/UwuRowBadgeGlyph"
                                android:src="@drawable/ic_connection" />
                        </FrameLayout>

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_mtu" />

                            <TextView
                                android:id="@+id/tv_mtu_value"
                                style="@style/SettingsRowSummary" />
                        </LinearLayout>

                        <ImageView style="@style/UwuRowChevron" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/row_dns"
                        style="@style/SettingsRow">

                        <FrameLayout style="@style/UwuRowBadge">
                            <ImageView style="@style/UwuRowBadgePlate" />
                            <ImageView
                                style="@style/UwuRowBadgeGlyph"
                                android:src="@drawable/ic_dns" />
                        </FrameLayout>

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_dns" />

                            <TextView
                                style="@style/SettingsRowSummary"
                                android:text="@string/settings_dns_summary" />
                        </LinearLayout>

                        <ImageView style="@style/UwuRowChevron" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/row_apps"
                        style="@style/SettingsRow">

                        <FrameLayout style="@style/UwuRowBadge">
                            <ImageView style="@style/UwuRowBadgePlate" />
                            <ImageView
                                style="@style/UwuRowBadgeGlyph"
                                android:src="@drawable/ic_per_apps_24dp" />
                        </FrameLayout>

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_per_app" />

                            <TextView
                                android:id="@+id/tv_apps_value"
                                style="@style/SettingsRowSummary" />
                        </LinearLayout>

                        <ImageView style="@style/UwuRowChevron" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/row_ipv6"
                        style="@style/SettingsRow">

                        <FrameLayout style="@style/UwuRowBadge">
                            <ImageView style="@style/UwuRowBadgePlate" />
                            <ImageView
                                style="@style/UwuRowBadgeGlyph"
                                android:src="@drawable/ic_wan" />
                        </FrameLayout>

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_ipv6" />

                            <TextView
                                style="@style/SettingsRowSummary"
                                android:text="@string/settings_ipv6_summary" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_ipv6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:clickable="false"
                            android:focusable="false" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/row_autoconnect"
                        style="@style/SettingsRow">

                        <FrameLayout style="@style/UwuRowBadge">
                            <ImageView style="@style/UwuRowBadgePlate" />
                            <ImageView
                                style="@style/UwuRowBadgeGlyph"
                                android:src="@drawable/ic_service_idle" />
                        </FrameLayout>

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_autoconnect" />

                            <TextView
                                style="@style/SettingsRowSummary"
                                android:text="@string/settings_autoconnect_summary" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_autoconnect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:clickable="false"
                            android:focusable="false" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Core ===== -->
            <LinearLayout style="@style/UwuSectionHeader">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/uwu_icon_miku" />
                <TextView
                    style="@style/UwuSectionHeaderLabel"
                    android:text="@string/settings_section_core" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/row_mode"
                        style="@style/SettingsRow">

                        <FrameLayout style="@style/UwuRowBadge">
                            <ImageView style="@style/UwuRowBadgePlate" />
                            <ImageView
                                style="@style/UwuRowBadgeGlyph"
                                android:src="@drawable/ic_routing_24dp" />
                        </FrameLayout>

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_mode" />

                            <TextView
                                android:id="@+id/tv_mode_value"
                                style="@style/SettingsRowSummary" />
                        </LinearLayout>

                        <ImageView style="@style/UwuRowChevron" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/row_log"
                        style="@style/SettingsRow">

                        <FrameLayout style="@style/UwuRowBadge">
                            <ImageView style="@style/UwuRowBadgePlate" />
                            <ImageView
                                style="@style/UwuRowBadgeGlyph"
                                android:src="@drawable/ic_logcat_24dp" />
                        </FrameLayout>

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_log" />

                            <TextView
                                android:id="@+id/tv_log_value"
                                style="@style/SettingsRowSummary" />
                        </LinearLayout>

                        <ImageView style="@style/UwuRowChevron" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/row_unified_delay"
                        style="@style/SettingsRow">

                        <FrameLayout style="@style/UwuRowBadge">
                            <ImageView style="@style/UwuRowBadgePlate" />
                            <ImageView
                                style="@style/UwuRowBadgeGlyph"
                                android:src="@drawable/ic_baseline_speed_24" />
                        </FrameLayout>

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_unified_delay" />

                            <TextView
                                style="@style/SettingsRowSummary"
                                android:text="@string/settings_unified_delay_summary" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_unified_delay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:clickable="false"
                            android:focusable="false" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/row_tcp_concurrent"
                        style="@style/SettingsRow">

                        <FrameLayout style="@style/UwuRowBadge">
                            <ImageView style="@style/UwuRowBadgePlate" />
                            <ImageView
                                style="@style/UwuRowBadgeGlyph"
                                android:src="@drawable/ic_qu_switch_24dp" />
                        </FrameLayout>

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_tcp_concurrent" />

                            <TextView
                                style="@style/SettingsRowSummary"
                                android:text="@string/settings_tcp_concurrent_summary" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_tcp_concurrent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:clickable="false"
                            android:focusable="false" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/row_tun_stack"
                        style="@style/SettingsRow">

                        <FrameLayout style="@style/UwuRowBadge">
                            <ImageView style="@style/UwuRowBadgePlate" />
                            <ImageView
                                style="@style/UwuRowBadgeGlyph"
                                android:src="@drawable/ic_router" />
                        </FrameLayout>

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_tun_stack" />

                            <TextView
                                android:id="@+id/tv_stack_value"
                                style="@style/SettingsRowSummary" />
                        </LinearLayout>

                        <ImageView style="@style/UwuRowChevron" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/row_allow_lan"
                        style="@style/SettingsRow">

                        <FrameLayout style="@style/UwuRowBadge">
                            <ImageView style="@style/UwuRowBadgePlate" />
                            <ImageView
                                style="@style/UwuRowBadgeGlyph"
                                android:src="@drawable/ic_lan" />
                        </FrameLayout>

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_allow_lan" />

                            <TextView
                                style="@style/SettingsRowSummary"
                                android:text="@string/settings_allow_lan_summary" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_allow_lan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:clickable="false"
                            android:focusable="false" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/row_test_url"
                        style="@style/SettingsRow">

                        <FrameLayout style="@style/UwuRowBadge">
                            <ImageView style="@style/UwuRowBadgePlate" />
                            <ImageView
                                style="@style/UwuRowBadgeGlyph"
                                android:src="@drawable/ic_cloud" />
                        </FrameLayout>

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_test_url" />

                            <TextView
                                android:id="@+id/tv_test_url_value"
                                style="@style/SettingsRowSummary" />
                        </LinearLayout>

                        <ImageView style="@style/UwuRowChevron" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/row_test_timeout"
                        style="@style/SettingsRow">

                        <FrameLayout style="@style/UwuRowBadge">
                            <ImageView style="@style/UwuRowBadgePlate" />
                            <ImageView
                                style="@style/UwuRowBadgeGlyph"
                                android:src="@drawable/ic_clock" />
                        </FrameLayout>

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_test_timeout" />

                            <TextView
                                android:id="@+id/tv_test_timeout_value"
                                style="@style/SettingsRowSummary" />
                        </LinearLayout>

                        <ImageView style="@style/UwuRowChevron" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Backup ===== -->
            <LinearLayout style="@style/UwuSectionHeader">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/uwu_icon_miku" />
                <TextView
                    style="@style/UwuSectionHeaderLabel"
                    android:text="@string/settings_section_backup" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/row_export"
                        style="@style/SettingsRow">

                        <FrameLayout style="@style/UwuRowBadge">
                            <ImageView style="@style/UwuRowBadgePlate" />
                            <ImageView
                                style="@style/UwuRowBadgeGlyph"
                                android:src="@drawable/ic_backup_24dp" />
                        </FrameLayout>

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_export" />

                            <TextView
                                style="@style/SettingsRowSummary"
                                android:text="@string/settings_export_summary" />
                        </LinearLayout>

                        <ImageView style="@style/UwuRowChevron" />
                    </LinearLayout>

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:id="@+id/row_import"
                        style="@style/SettingsRow">

                        <FrameLayout style="@style/UwuRowBadge">
                            <ImageView style="@style/UwuRowBadgePlate" />
                            <ImageView
                                style="@style/UwuRowBadgeGlyph"
                                android:src="@drawable/ic_restore_24dp" />
                        </FrameLayout>

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_import" />

                            <TextView
                                style="@style/SettingsRowSummary"
                                android:text="@string/settings_import_summary" />
                        </LinearLayout>

                        <ImageView style="@style/UwuRowChevron" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
