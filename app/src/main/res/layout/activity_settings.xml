<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBg">

    <com.google.android.material.appbar.AppBarLayout
        app:liftOnScroll="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            style="?attr/collapsingToolbarLayoutLargeStyle"
            android:layout_height="?attr/collapsingToolbarLayoutLargeSize"
            android:background="?attr/colorPrimary"
            app:collapsedTitleTextColor="?attr/colorOnPrimary"
            app:contentScrim="?attr/colorPrimary"
            app:expandedTitleMarginEnd="24dp"
            app:expandedTitleMarginStart="24dp"
            app:expandedTitleTextColor="?attr/colorOnPrimary"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:statusBarScrim="?attr/colorPrimary"
            app:title="@string/settings"
            app:titleCollapseMode="scale">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/uwu_circle_back"
                app:titleTextColor="?attr/colorOnPrimary" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/uwu_banner_settings_port" />

            <!-- maintainer notice -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/uwu_maintainer_title"
                            android:textColor="?attr/colorOnPrimary"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/uwu_maintainer_summary"
                            android:textColor="?attr/colorOnPrimary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_account_cog_outline"
                        app:tint="?attr/colorOnPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Appearance ===== -->
            <LinearLayout style="@style/UwuGroupHeader">
                <ImageView
                    style="@style/UwuGroupHeaderIcon"
                    android:src="@drawable/ic_palette_24" />

                <TextView
                    style="@style/UwuGroupHeaderLabel"
                    android:text="@string/settings_section_appearance" />
            </LinearLayout>

            <include
                android:id="@+id/row_theme_color"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_dynamic_color"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_dynamic_banner"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_dark_mode"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_true_black"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_font"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_font_size"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_bold_text"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_language"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_profile_name"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_particles"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_quick_actions"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_fab_extended"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_compact_actions"
                layout="@layout/uwu_row" />

            <!-- ===== General ===== -->
            <LinearLayout style="@style/UwuGroupHeader">
                <ImageView
                    style="@style/UwuGroupHeaderIcon"
                    android:src="@drawable/ic_wan" />

                <TextView
                    style="@style/UwuGroupHeaderLabel"
                    android:text="@string/settings_section_general" />
            </LinearLayout>

            <include
                android:id="@+id/row_boot"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_autoconnect"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_mode"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_log"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_tun_stack"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_mtu"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_unified_delay"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_tcp_concurrent"
                layout="@layout/uwu_row" />

            <!-- ===== Route ===== -->
            <LinearLayout style="@style/UwuGroupHeader">
                <ImageView
                    style="@style/UwuGroupHeaderIcon"
                    android:src="@drawable/ic_lan" />

                <TextView
                    style="@style/UwuGroupHeaderLabel"
                    android:text="@string/settings_section_route" />
            </LinearLayout>

            <include
                android:id="@+id/row_apps"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_ipv6"
                layout="@layout/uwu_row" />

            <!-- ===== Inbound ===== -->
            <LinearLayout style="@style/UwuGroupHeader">
                <ImageView
                    style="@style/UwuGroupHeaderIcon"
                    android:src="@drawable/ic_wan" />

                <TextView
                    style="@style/UwuGroupHeaderLabel"
                    android:text="@string/settings_section_inbound" />
            </LinearLayout>

            <include
                android:id="@+id/row_allow_lan"
                layout="@layout/uwu_row" />

            <!-- ===== DNS ===== -->
            <LinearLayout style="@style/UwuGroupHeader">
                <ImageView
                    style="@style/UwuGroupHeaderIcon"
                    android:src="@drawable/ic_dns" />

                <TextView
                    style="@style/UwuGroupHeaderLabel"
                    android:text="@string/dns_title" />
            </LinearLayout>

            <include
                android:id="@+id/row_dns"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_advanced"
                layout="@layout/uwu_row" />

            <!-- ===== Miscellaneous ===== -->
            <LinearLayout style="@style/UwuGroupHeader">
                <ImageView
                    style="@style/UwuGroupHeaderIcon"
                    android:src="@drawable/ic_backup_24dp" />

                <TextView
                    style="@style/UwuGroupHeaderLabel"
                    android:text="@string/settings_section_misc" />
            </LinearLayout>

            <include
                android:id="@+id/row_test_url"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_test_timeout"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_export"
                layout="@layout/uwu_row" />

            <include
                android:id="@+id/row_import"
                layout="@layout/uwu_row" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
