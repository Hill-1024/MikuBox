<?xml version="1.0" encoding="utf-8"?>
<!--
    One row of a MikuRay-style settings/menu section. Screens include this file
    with an id and then decide, per row, which trailing widget is visible and
    whether the card sits at the top, middle, bottom or alone in its section
    (see UwuRow.applyStyle).
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row_card"
    style="@style/UwuCardRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:layout_marginTop="10dp"
    tools:shapeAppearanceOverlay="@style/ShapeAppearance.App.CardView.Top">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/row_badge"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@drawable/uwu_bg_circle_primary">

            <ImageView
                android:id="@+id/row_icon"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:tint="?attr/colorOnPrimary"
                tools:src="@drawable/ic_settings_24dp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row_title"
                style="@style/UwuRowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Subscription" />

            <TextView
                android:id="@+id/row_summary"
                style="@style/UwuRowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="Update every 24 hours"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/row_value"
            style="@style/UwuRowValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:text="Follow system"
            tools:visibility="visible" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/row_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/row_arrow"
            style="@style/UwuRowArrowPuck"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
