<?xml version="1.0" encoding="utf-8"?>
<!--
    Home screen following the release branch's scaffold: a solid colourPrimary
    toolbar, the artwork presented as a rounded banner card (blurred landscape
    behind, a portrait card on top of it, avatar and greeting at the bottom
    left), then a rounded content sheet carrying the tab strip and the profile
    list. The mode switch, the quick actions and the status card sit on top of
    the sheet at the bottom.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPrimary">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ===== toolbar ===== -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="?attr/colorPrimary"
            app:elevation="0dp">

            <LinearLayout
                android:id="@+id/header_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/header_top_row"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_home"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/action_menu"
                        app:backgroundTint="@android:color/transparent"
                        app:icon="@drawable/ic_navigation_menu"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="24dp"
                        app:iconTint="?attr/colorOnPrimary"
                        app:rippleColor="?attr/colorOnPrimary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/uwu_font_title"
                        android:maxLines="1"
                        android:text="@string/app_name"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_search"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/search_hint"
                        app:backgroundTint="@android:color/transparent"
                        app:icon="@drawable/ic_search_icon"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="23dp"
                        app:iconTint="?attr/colorOnPrimary"
                        app:rippleColor="?attr/colorOnPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_config"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/action_add_profile"
                        app:backgroundTint="@android:color/transparent"
                        app:icon="@drawable/ic_add_circle_fill_24px"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="23dp"
                        app:iconTint="?attr/colorOnPrimary"
                        app:rippleColor="?attr/colorOnPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_more_menu"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/action_more"
                        app:backgroundTint="@android:color/transparent"
                        app:icon="@drawable/ic_baseline_more_vert_24"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="23dp"
                        app:iconTint="?attr/colorOnPrimary"
                        app:rippleColor="?attr/colorOnPrimary" />
                </LinearLayout>

                <!-- Inline search, revealed by the toolbar search button. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/search_row"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorCard"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_search_icon"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <androidx.appcompat.widget.SearchView
                            android:id="@+id/search_view_inline"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            app:closeIcon="@null"
                            app:iconifiedByDefault="false"
                            app:queryBackground="@android:color/transparent"
                            app:queryHint="@string/search_hint"
                            app:searchIcon="@null" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- ===== banner card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/banner_home"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_below="@id/app_bar"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="?attr/colorCard"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorCard"
            app:strokeWidth="3dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/header_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/uwu_banner_home" />

                <View
                    android:id="@+id/header_image_fade"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#33000000"
                    android:importantForAccessibility="no" />

                <!-- Portrait artwork card, the signature of the release layout. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/banner_portrait"
                    android:layout_width="112dp"
                    android:layout_height="170dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="14dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/uwu_banner_image" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_profile"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/uwu_banner_profile"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Miku.Circle"
                        app:strokeColor="@android:color/white"
                        app:strokeWidth="3dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="120dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_username"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="marquee"
                            android:shadowColor="#66000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="6"
                            android:singleLine="true"
                            android:textColor="@android:color/white"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="Hi, master" />

                        <TextView
                            android:id="@+id/tv_greeting_sub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="marquee"
                            android:shadowColor="#66000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="6"
                            android:singleLine="true"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            tools:text="Good morning…" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== content sheet ===== -->
        <FrameLayout
            android:id="@+id/content_sheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/banner_home"
            android:layout_marginTop="14dp"
            android:background="@drawable/uwu_background_collapse">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_profiles"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="66dp"
                    android:paddingBottom="@dimen/uwu_list_bottom_padding"
                    tools:listitem="@layout/item_profile" />

                <LinearLayout
                    android:id="@+id/tab_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="?attr/colorCard"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:contentPadding="4dp"
                        app:strokeWidth="0dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/tab_card_inner"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <com.google.android.material.tabs.TabLayout
                                android:id="@+id/group_tab"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@android:color/transparent"
                                app:tabIndicator="@drawable/uwu_tabs_rounded_indicator"
                                app:tabIndicatorAnimationMode="elastic"
                                app:tabIndicatorColor="?attr/colorPrimary"
                                app:tabIndicatorFullWidth="true"
                                app:tabIndicatorHeight="44dp"
                                app:tabMinWidth="0dp"
                                app:tabMode="scrollable"
                                app:tabPaddingStart="0dp"
                                app:tabPaddingEnd="0dp"
                                app:tabRippleColor="@android:color/transparent" />
                        </com.google.android.material.card.MaterialCardView>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </RelativeLayout>
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/uwu_bg_fade_bottom"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/layout_quick_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/status_panel"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quick_sub_update"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/title_sub_update"
                app:backgroundTint="?attr/colorPrimaryContainer"
                app:icon="@drawable/ic_cloud_download_24dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="?attr/colorOnPrimaryContainer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quick_sort"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/action_sort"
                app:backgroundTint="?attr/colorSecondaryContainer"
                app:icon="@drawable/ic_sort"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="?attr/colorOnSecondaryContainer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quick_tcping"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/title_ping_all_server"
                app:backgroundTint="?attr/colorTertiaryContainer"
                app:icon="@drawable/ic_baseline_speed_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="?attr/colorOnTertiaryContainer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quick_proxies"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/menu_proxies"
                app:backgroundTint="?attr/colorErrorContainer"
                app:icon="@drawable/ic_lan"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="?attr/colorOnErrorContainer" />
        </LinearLayout>

        <!--
            Routing mode: rule evaluates the profile's rules, global sends every
            connection to the GLOBAL selector, direct stops proxying. The exit row
            shows up in global mode only and opens the exit picker.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/layout_quick_actions"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="?attr/colorCard"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:contentPadding="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/mode_tab"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    app:tabIndicator="@drawable/uwu_tabs_rounded_indicator"
                    app:tabIndicatorAnimationMode="elastic"
                    app:tabIndicatorColor="?attr/colorPrimary"
                    app:tabIndicatorFullWidth="true"
                    app:tabIndicatorHeight="44dp"
                    app:tabMode="fixed"
                    app:tabRippleColor="@android:color/transparent"
                    app:tabSelectedTextColor="?attr/colorSurface"
                    app:tabTextColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/mode_exit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="全局出口 · Hong Kong 01 ▾"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
            Status card: the whole card re-tests the current node, the trailing
            button connects and disconnects (extended with the session timer).
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/status_panel"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorPrimary"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <View
                    android:id="@+id/status_glow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:background="@drawable/uwu_status_glow"
                    android:importantForAccessibility="no" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:id="@+id/status_text_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="8dp"
                        android:layout_toStartOf="@id/fab"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_ip_state"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alpha="0.8"
                            android:ellipsize="marquee"
                            android:singleLine="true"
                            android:textColor="?attr/colorOnPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="↑ 0.0 B/s  ↓ 0.0 B/s" />

                        <TextView
                            android:id="@+id/tv_test_state"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="marquee"
                            android:singleLine="true"
                            android:text="@string/connection_test_pending"
                            android:textColor="?attr/colorOnPrimary"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                        android:id="@+id/fab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="@string/action_connect"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:backgroundTint="?attr/colorOnPrimary"
                        app:cornerRadius="16dp"
                        app:elevation="0dp"
                        app:icon="@drawable/ic_service_idle"
                        app:iconGravity="end"
                        app:iconPadding="4dp"
                        app:iconTint="?attr/colorPrimary" />
                </RelativeLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>
</FrameLayout>
